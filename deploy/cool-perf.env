# Configuration of the nightly performance run, read by cool-perf.service.
# deploy/setup-vm copies this file to /etc/cool-perf.env once, replacing
# @HOME@ with the service user's home. Later edits go to /etc/cool-perf.env.
# Every variable that cool-ci, cool-build and browser-suite.py read can be set
# here; CI-JENKINS.md lists them all.

# The online tree that is built and measured. The engine is engine/ inside it.
COOLWSD_DIR=@HOME@/online

# Where it is cloned from the first time, and what each night builds. The
# GitHub mirror needs no account.
COOL_SRC_URL=https://github.com/CollaboraOnline/online.mirror.git
COOL_SRC_REF=origin/main

# The published runs and the dashboard, served by nginx. 60 nightly runs are
# two months of history, about 500 MB.
COOL_PERF_STORE=/var/lib/cool-perf
COOL_PERF_KEEP=60

# 1: rebuild the engine every night, incrementally. The engine is in the same
# repository as the server, so a commit on main can change both, and a server
# built against an older engine can crash the kit. 0 only builds the server.
COOL_PERF_ENGINE=1

# 1: keep each night's build as a snapshot under COOL_BUILDS_DIR, so that
# cool-use-build can measure it again later. Each one is about 4 GB.
COOL_PERF_SAVE_BUILDS=0
COOL_BUILDS_DIR=@HOME@/cool-builds

# 1: git pull --ff-only the perf-dashboard checkout before each run. It needs
# a remote that the machine can read without a prompt (see DEPLOY-VM.md).
COOL_PERF_SELF_UPDATE=0
