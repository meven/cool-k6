def latest_runid(results: Path) -> str | None:
    """Newest run directory. The runid starts with a UTC timestamp, so the
    lexical maximum is the most recent."""
    if not results.is_dir():
        return None
    runs = sorted(p.name for p in results.iterdir() if p.is_dir())
    return runs[-1] if runs else None


def publish(runid: str, store: Path, keep: int, junit: Path | None = None,
            remember: bool = True) -> int:
    """Copy one run into the store, delete it from results/ unless COOL_PERF_KEEP_RESULTS=1,
    prune old ones, rebuild the store dashboard. Without @p remember, the run does not become
    the last run of its branch, which deploy/nightly then measures again.

    The store is the durable half: a CI workspace is wiped between builds, so
    the history that the charts plot has to live outside it. The dashboard is
    written at the top of the store, which is also what makes its links to the
    captures resolve (they are relative to the html)."""
    src = ROOT / "results" / runid
    if not src.is_dir():
        print(f"nothing to publish: {src} does not exist", file=sys.stderr)
        return 1
    dst_results = store / "results"
    dst_results.mkdir(parents=True, exist_ok=True)
    dst = dst_results / runid
    print(f"publishing {runid} to {dst}")
    if dst.exists():
        shutil.rmtree(dst, ignore_errors=True)
    subprocess.run(["cp", "-a", str(src), str(dst)], check=True)
    if junit and junit.is_file():
        (store / "junit").mkdir(parents=True, exist_ok=True)
        shutil.copy2(junit, store / "junit" / f"{runid}.xml")
    # The dashboard reads the store copy, so the workspace keeps no run once it is published,
    # unless a CI job archives it from there.
    if env("COOL_PERF_KEEP_RESULTS", "0") != "1":
        shutil.rmtree(src, ignore_errors=True)

    runs = sorted(p for p in dst_results.iterdir() if p.is_dir())
    if keep > 0 and len(runs) > keep:
        for old in runs[:len(runs) - keep]:
            print(f"pruning {old.name} (keeping {keep})")
            shutil.rmtree(old, ignore_errors=True)

    rc = subprocess.run([sys.executable, str(ROOT / "browser-suite.py"),
                         "--results", str(dst_results),
                         "-o", str(store / "index.html")],
                        cwd=str(ROOT)).returncode
    if rc != 0:
        print("could not rebuild the store dashboard", file=sys.stderr)
        return rc
    if not remember:
        print(f"\ndashboard: {store / 'index.html'}")
        return 0
    label = build_label()[0]
    # The last label of each branch, which deploy/nightly compares the tip of main with:
    # last-run.json names a change once one was measured after main. A store from before
    # this file starts it from the run that last-run.json still names, which was of main.
    last = store / "last-runs.json"
    try:
        labels = json.loads(last.read_text())
    except (OSError, ValueError):
        try:
            prev = json.loads((store / "last-run.json").read_text())
            labels = {prev.get("branch", "main"): prev["label"]}
        except (OSError, ValueError, KeyError):
            labels = {}
    labels[branch()] = label
    last.write_text(json.dumps(labels, indent=2) + "\n")
    (store / "last-run.json").write_text(json.dumps({
        "runid": runid,
        "label": label,
        "branch": branch(),
        "published_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "runs_in_store": len(sorted(p for p in dst_results.iterdir() if p.is_dir())),
    }, indent=2) + "\n")
    print(f"\ndashboard: {store / 'index.html'}")
    return 0


def cmd_publish(args) -> int:
    runid = args.runid or latest_runid(ROOT / "results")
    if not runid:
        print("no run to publish under results/", file=sys.stderr)
        return 1
    return publish(runid, store_dir(), int(env("COOL_PERF_KEEP", "20")))


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Run the Collabora Online performance suite under CI.",
        epilog="Configuration comes from the environment, see the module docstring.")
    sub = ap.add_subparsers(dest="cmd")

    d = sub.add_parser("doctor", help="check the machine can run the suite")
    d.add_argument("--strict", action="store_true", help="treat warnings as failures")
    d.add_argument("--flamegraphs", action=argparse.BooleanOptionalAction, default=True,
                   help="check what the flamegraph pass needs as well (default: yes)")
    d.set_defaults(func=cmd_doctor)

    r = sub.add_parser("run", help="doctor, run the suite, publish the results")
    # The captures give the times as well, within the noise of a run without perf, so a
    # plain pass would measure every test a second time.
    r.add_argument("--suite", action=argparse.BooleanOptionalAction,
                   default=env("COOL_PERF_SUITE", "0") == "1",
                   help="also run each test without perf, on one shared coolwsd that this "
                        "starts and stops itself (env COOL_PERF_SUITE=1)")
    r.add_argument("--flamegraphs", action=argparse.BooleanOptionalAction, default=True,
                   help=f"capture a flamegraph per document ({DOC_COUNT}) and user count")
    r.add_argument("--users", default=env("COOL_PERF_USERS", "1,3"),
                   help="user counts for the timing suite and the flamegraphs "
                        "(env COOL_PERF_USERS)")
    r.add_argument("--documents", choices=("generated", "reference", "all"),
                   default=env("COOL_PERF_DOCUMENTS", "generated"),
                   help="the documents of browser-suite.py --documents: those that "
                        "documents/gen-docs.py writes, the real ones that "
                        "documents/fetch-reference-docs.py downloads, or both "
                        "(env COOL_PERF_DOCUMENTS)")
    r.add_argument("--publish", action=argparse.BooleanOptionalAction, default=True,
                   help="copy the run into COOL_PERF_STORE and rebuild its dashboard. "
                        "--no-publish leaves it in results/ and needs no store")
    r.add_argument("--junit", default="ci-logs/junit.xml", help="JUnit report path")
    r.add_argument("--min-samples", type=int, default=int(env("COOL_PERF_MIN_SAMPLES", "30")),
                   help="fail a document whose capture collected fewer perf "
                        "samples than this (env COOL_PERF_MIN_SAMPLES, 0 = off)")
    r.add_argument("--strict", action="store_true",
                   help="fail the job if any single document fails")
    r.set_defaults(func=cmd_run)

    p = sub.add_parser("publish", help="copy a run into the store, rebuild its dashboard")
    p.add_argument("--runid", help="which run to publish (default: the newest)")
    p.set_defaults(func=cmd_publish)

    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
