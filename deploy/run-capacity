#!/bin/bash
# Run the capacity test, cool-capacity-test.js under capacity-profile, against the build that the
# online tree holds, and keep its results in the store under capacity/, which nginx lists.
#
# Run as the service user, or schedule it with systemd-run as DEPLOY-VM.md shows:
#
#   deploy/run-capacity                   the default staircase: 10, 20, 30 ... 160 users
#   deploy/run-capacity --wait            queue behind a run of the timer
#   deploy/run-capacity --gerrit 19945    build the current patch set of a Gerrit change first,
#                                         or 19945/2 for one patch set, under the same lock
#   deploy/run-capacity --ref origin/main build a ref of the online repository first, the same way
#   deploy/run-capacity writer calc       one run for each CAP_SCENARIO named, one after the other
#   deploy/run-capacity all               every scenario of cool-capacity-test.js
#   CAP_VUS=10,20 deploy/run-capacity     any CAP_* variable of cool-capacity-test.js, and
#                                         NO_BROWSER=1 or NO_PERF=1 of capacity-profile
#
# coolwsd, forkit and the kits run on 4 cores and in 8 GB of memory, the size of a small server:
# SERVER_CPUS (default 0-3) and SERVER_MEMORY (default 8G) of capacity-profile.
#
# It holds the lock of deploy/nightly for the whole run, so no timer run starts on the same ports,
# and it stops when cool-ci doctor fails, for example on a nearly full disk.
set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
cd "$REPO"

SCENARIOS="writer calc impress writer-pairs calc-pairs impress-pairs mixed"
SCENARIOS+=" writer-shared calc-shared impress-shared finance-shared"
. deploy/common.sh

wait=
change=
ref=
branch=
scenarios=()
while [ $# -gt 0 ]; do
    case $1 in
        --wait) wait=1; shift ;;
        --gerrit) change=$2; shift 2 ;;
        --ref) ref=$2; shift 2 ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        all) read -ra scenarios <<< "$SCENARIOS"; shift ;;
        -*) echo "unknown argument: $1" >&2; exit 2 ;;
        *) [[ " $SCENARIOS " == *" $1 "* ]] || { echo "unknown scenario: $1" >&2; exit 2; }
           scenarios+=("$1"); shift ;;
    esac
done
# No scenario name runs the test once, with CAP_SCENARIO from the environment if set.
[ ${#scenarios[@]} -gt 0 ] || scenarios=("${CAP_SCENARIO:-}")

set -a; . /etc/cool-perf.env; set +a
: "${COOLWSD_DIR:?not set in /etc/cool-perf.env}"

take_lock "$wait"
# The build is made under the same lock as the runs, so no other run can build another commit in
# the tree between the two.
[ -z "$change" ] || [ -z "$ref" ] || { echo "give --gerrit or --ref, not both" >&2; exit 2; }
if [ -n "$change" ] || [ -n "$ref" ]; then
    if [ -n "$change" ]; then
        ref=$(gerrit_ref "$change")
        branch=gerrit-${change%%/*}
        build_args=(--no-save --ref "$ref" --from "$GERRIT_URL/online")
    else
        build_args=(--no-save --ref "$ref")
        branch=${ref#origin/}
    fi
    [ "${COOL_PERF_ENGINE:-1}" = 1 ] && build_args+=(--engine)
    echo "=== building $ref${change:+ of change ${change%%/*}}"
    lock_step "building"
    ./cool-build "${build_args[@]}"
fi
build_bundles
build_documents
./cool-ci doctor

store=${COOL_PERF_STORE:-/var/lib/cool-perf}
commit=$(git -C "$COOLWSD_DIR" rev-parse --short=12 HEAD)
status=0
for scenario in "${scenarios[@]}"; do
    out=$store/capacity/$(date -u +%Y%m%dT%H%M%SZ)-$commit
    mkdir -p "$out"
    # The dashboard names the scenario of a run before capacity.json exists.
    [ -z "$scenario" ] || echo "$scenario" > "$out/scenario"
    # The Capacity tab shows the branch and the ref of a build made here beside the commit.
    [ -z "$branch" ] || python3 -c 'import json, sys
print(json.dumps({"branch": sys.argv[1], "ref": sys.argv[2]}))' "$branch" "$ref" > "$out/build.json"
    echo "=== capacity run of $commit${scenario:+, scenario $scenario}, into $out"
    lock_step "measuring${scenario:+ $scenario}"

    # A coolwsd left by an earlier run would answer instead of the one that capacity-profile
    # starts.
    pkill -u "$(id -u)" -x coolwsd || true
    # A WOPI host of its own, on a free port: one already on 3000 presents a certificate that
    # coolwsd does not trust, and every session is refused. Its own WOPI host also numbers the
    # users of each run from 0.
    wopi_port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("", 0)); print(s.getsockname()[1])')
    # A failed run, such as one stopped on low memory, does not stop the next scenarios.
    WOPI_HOST=https://localhost:$wopi_port/ CAP_SCENARIO=$scenario OUT_DIR=$out \
        PRUNE_PERF_DATA=1 ./capacity-profile || status=$?
    echo "the capacity run of $commit is in $out, listed under /capacity/ on the dashboard host"
done
exit "$status"
