<?xml version="1.0"?>
<!-- The glyph layout cache of each kit holds at most 5 MB of glyphs, against 20 MB by
     default. capacity-profile installs it with ENGINE_CONFIG. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Cache">
      <node oor:name="Font">
        <prop oor:name="GlyphsCacheSize" oor:op="fuse">
          <value>5000000</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
