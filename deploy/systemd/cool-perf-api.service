[Unit]
Description=Delete and queue runs of the performance dashboard from its Schedule tab
Documentation=file://@REPO@/DEPLOY-VM.md
After=network.target

[Service]
User=@USER@
Group=@USER@
EnvironmentFile=/etc/cool-perf.env
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 @REPO@/deploy/runs-api.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
