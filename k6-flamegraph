#!/bin/bash
#
# k6-flamegraph: drive a coolwsd workload with a k6 test and capture a
# perf flamegraph of the kit activity.
#
# Usage:
#   k6-flamegraph [test-script]
#
# test-script defaults to dist/cool-browser-profile-test.js (relative
# to this script), which dumps a Chrome CPU profile via CDP markers
# the wrapper then extracts.
#
# Environment overrides:
#   COOLWSD_DIR        - path to the online checkout (default /home/meven/code/online)
#   COOLWSD_URL        - URL coolwsd serves at      (default https://localhost:9980/)
#   HOST_IP            - host IP reachable from the k6 docker container
#                        (default: auto-detected via `ip route`)
#   WOPI_PORT          - WOPI host port             (default 3000)
#   WOPI_SCHEME        - http or https (default https; the demo html
#                        rejects http parent + https iframe so this
#                        must match coolwsd's scheme)
#   WOPI_SSL_KEY       - TLS key for the WOPI host (default
#                        $COOLWSD_DIR/etc/key.pem; only used when
#                        WOPI_SCHEME=https)
#   WOPI_SSL_CRT       - TLS cert (default $COOLWSD_DIR/etc/cert.pem)
#   OUT_DIR            - output directory           (default ./profile-out)
#   PERF_FREQ          - perf sampling frequency Hz (default 50)
#   WITH_BROWSER_PROFILE - if 1 (default), extract a Chrome CPU profile
#                          from the k6 log; set to 0 to skip. The test
#                          must dump it with the __CPUPROFILE_* markers,
#                          e.g. dist/cool-browser-profile-test.js.
#
# Outputs (under $OUT_DIR):
#   coolwsd.log         - coolwsd stdout/stderr (only if this script started it)
#   wopi.log            - WOPI host stdout/stderr (only if this script started it)
#   k6.log              - k6 test stdout/stderr
#   perf.log            - perf record stderr
#   perf.data           - raw perf samples
#   flamegraph.svg      - rendered kit flamegraph
#   browser.cpuprofile  - V8 CPU profile (only with WITH_BROWSER_PROFILE=1);
#                         open in https://www.speedscope.app/ or Chrome
#                         DevTools (Performance tab -> Load profile)

set -euo pipefail

START_TS=$SECONDS

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEST_SCRIPT="${1:-dist/cool-browser-profile-test.js}"
WITH_BROWSER_PROFILE="${WITH_BROWSER_PROFILE:-1}"

COOLWSD_DIR="${COOLWSD_DIR:-/home/meven/code/online}"
COOLWSD_URL="${COOLWSD_URL:-https://localhost:9980/}"
WOPI_PORT="${WOPI_PORT:-3000}"
OUT_DIR="${OUT_DIR:-profile-out}"
PERF_FREQ="${PERF_FREQ:-50}"

HOST_IP="${HOST_IP:-$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{for(i=1;i<=NF;i++)if($i=="src"){print $(i+1);exit}}')}"
if [ -z "$HOST_IP" ]; then
    echo "could not auto-detect HOST_IP; set HOST_IP=<your host IP>" >&2
    exit 1
fi

# preconditions
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "missing required command: $1" >&2
        echo "$2" >&2
        exit 1
    fi
}
need perf "Install perf (Arch: sudo pacman -S perf, Fedora: sudo dnf install perf)"
need stackcollapse-perf.pl "Install FlameGraph (Arch AUR: yay -S flamegraph; Fedora: sudo dnf install flamegraph; or manually: git clone https://github.com/brendangregg/FlameGraph ~/FlameGraph and add ~/FlameGraph to PATH)"
need flamegraph.pl "Install FlameGraph (Arch AUR: yay -S flamegraph; Fedora: sudo dnf install flamegraph; or manually: git clone https://github.com/brendangregg/FlameGraph ~/FlameGraph and add ~/FlameGraph to PATH)"
need docker "k6-wrap uses docker; install and enable the docker daemon"
need pgrep "pgrep should be in any base install"

if [ ! -d "$COOLWSD_DIR" ]; then
    echo "coolwsd directory not found: $COOLWSD_DIR" >&2
    exit 1
fi
if [ ! -f "$SCRIPT_DIR/$TEST_SCRIPT" ]; then
    echo "k6 test script not found: $SCRIPT_DIR/$TEST_SCRIPT" >&2
    echo "(did you run \`npm run build\` in $SCRIPT_DIR?)" >&2
    exit 1
fi

PARANOID=$(cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null || echo 4)
USE_SUDO_PERF=()
# paranoid >= 1 blocks CPU event access for non-root; only then need sudo.
if [ "$PARANOID" -gt 0 ]; then
    USE_SUDO_PERF=(sudo)
    echo "kernel.perf_event_paranoid=$PARANOID; will run perf via sudo"
fi

mkdir -p "$OUT_DIR"

COOLWSD_PID=""
WOPI_PID=""
PERF_PID=""
K6_PID=""
STARTED_COOLWSD=0
STARTED_WOPI=0

cleanup() {
    set +e
    if [ -n "$PERF_PID" ]; then
        "${USE_SUDO_PERF[@]}" kill -SIGINT "$PERF_PID" 2>/dev/null
        wait "$PERF_PID" 2>/dev/null
    fi
    if [ -n "$K6_PID" ]; then
        kill "$K6_PID" 2>/dev/null
        wait "$K6_PID" 2>/dev/null
    fi
    if [ $STARTED_WOPI -eq 1 ] && [ -n "$WOPI_PID" ]; then
        kill "$WOPI_PID" 2>/dev/null
        wait "$WOPI_PID" 2>/dev/null
    fi
    if [ $STARTED_COOLWSD -eq 1 ] && [ -n "$COOLWSD_PID" ]; then
        # `make run` forks coolwsd; kill the process group
        kill -- -"$COOLWSD_PID" 2>/dev/null
        wait "$COOLWSD_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

wait_for() {
    # wait_for <description> <max-seconds> <test-command>
    local desc=$1 max=$2 cmd=$3 i
    for ((i=0; i<max; i++)); do
        if eval "$cmd" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    echo "timed out waiting for $desc" >&2
    return 1
}

# coolwsd
if curl -ks "${COOLWSD_URL}hosting/discovery" >/dev/null 2>&1; then
    echo "coolwsd already running at $COOLWSD_URL"
else
    echo "starting coolwsd from $COOLWSD_DIR ..."
    ( cd "$COOLWSD_DIR" && setsid make run-one ) \
        > "$OUT_DIR/coolwsd.log" 2>&1 &
    COOLWSD_PID=$!
    STARTED_COOLWSD=1
    wait_for "coolwsd ready" 60 "curl -ks ${COOLWSD_URL}hosting/discovery"
fi

# The WOPI demo page rejects loading a https Collabora server from an
# http parent (html/index.html scheme check). Run the WOPI host in
# https too, reusing coolwsd's self-signed cert.
WOPI_SCHEME="${WOPI_SCHEME:-https}"
WOPI_SSL_KEY="${WOPI_SSL_KEY:-${COOLWSD_DIR}/etc/key.pem}"
WOPI_SSL_CRT="${WOPI_SSL_CRT:-${COOLWSD_DIR}/etc/cert.pem}"
WOPI_BASE="${WOPI_SCHEME}://${HOST_IP}:${WOPI_PORT}"

# WOPI host
if curl -ks "${WOPI_BASE}/wopi/files/1" >/dev/null 2>&1; then
    echo "WOPI host already running at ${WOPI_BASE}/"
else
    if [ "$WOPI_SCHEME" = "https" ] && { [ ! -f "$WOPI_SSL_KEY" ] || [ ! -f "$WOPI_SSL_CRT" ]; }; then
        echo "missing TLS cert/key for WOPI host:" >&2
        echo "  key: $WOPI_SSL_KEY" >&2
        echo "  crt: $WOPI_SSL_CRT" >&2
        echo "set WOPI_SSL_KEY / WOPI_SSL_CRT (or WOPI_SCHEME=http) and retry." >&2
        exit 1
    fi
    echo "starting WOPI host on ${WOPI_BASE}/ ..."
    (
        cd "$SCRIPT_DIR" && \
        PORT="$WOPI_PORT" \
        SSL_KEY_FILE="$WOPI_SSL_KEY" \
        SSL_CRT_FILE="$WOPI_SSL_CRT" \
        NODE_TLS_REJECT_UNAUTHORIZED=0 \
        npm run server
    ) > "$OUT_DIR/wopi.log" 2>&1 &
    WOPI_PID=$!
    STARTED_WOPI=1
    wait_for "WOPI host ready" 30 "curl -ks ${WOPI_BASE}/wopi/files/1"
fi

# k6 runs inside docker, where "localhost" is the container's loopback,
# not the host. Translate localhost / 127.0.0.1 to the host IP so k6
# can reach the coolwsd running on the host.
COOLWSD_URL_DOCKER=$(echo "$COOLWSD_URL" | sed -E "s#//(localhost|127\\.0\\.0\\.1)([:/])#//${HOST_IP}\\2#")

# Limit perf to coolwsd and its kits. The actual process names (set
# via prctl in common/ProcUtil) are "coolwsd", "forkit", and "kit_*"
# (e.g. kit_spare_001, or doc-id-renamed kits). pgrep returns 1 when
# no match exists, which under set -euo pipefail would abort the
# script; the trailing `true` keeps the brace group's exit code clean.
# Falls back to system-wide (-a) if no coolwsd PIDs found.
COOL_PIDS=$( { pgrep -x coolwsd; pgrep -x forkit; pgrep '^kit_'; true; } 2>/dev/null | sort -u | paste -sd, -)
if [ -z "$COOL_PIDS" ]; then
    echo "no coolwsd processes found; perf will record system-wide (-a)"
    PERF_TARGET=(-a)
else
    echo "perf will record coolwsd PIDs: $COOL_PIDS"
    PERF_TARGET=(--pid "$COOL_PIDS")
fi

echo "starting perf record (F=${PERF_FREQ})..."
rm -f "$OUT_DIR/perf.data"
"${USE_SUDO_PERF[@]}" perf record -F"$PERF_FREQ" --call-graph dwarf,32768 \
    "${PERF_TARGET[@]}" \
    -o "$OUT_DIR/perf.data" \
    > "$OUT_DIR/perf.log" 2>&1 &
PERF_PID=$!

# wait until perf has actually started recording (perf.data has bytes)
# before launching the workload, otherwise short tests finish before
# perf has captured anything.
for i in {1..10}; do
    if [ -s "$OUT_DIR/perf.data" ]; then break; fi
    sleep 0.5
done
if ! [ -s "$OUT_DIR/perf.data" ]; then
    echo "perf failed to start recording; perf.log says:" >&2
    cat "$OUT_DIR/perf.log" >&2
    exit 1
fi

echo "starting k6 test: $TEST_SCRIPT (WOPI_URL=$COOLWSD_URL_DOCKER)..."
# k6-wrap docker mounts cwd to /app and runs with -w /app, so we must
# cd into SCRIPT_DIR and pass the test path relative to it.
(
    cd "$SCRIPT_DIR" && \
    WOPI_URL="$COOLWSD_URL_DOCKER" \
    WOPI_HOST="${WOPI_BASE}/" \
    NODE_TLS_REJECT_UNAUTHORIZED=0 \
        ./k6-run "$TEST_SCRIPT"
) > "$OUT_DIR/k6.log" 2>&1 &
K6_PID=$!

# wait for k6 to finish, then stop perf
echo "waiting for k6 to finish ..."
K6_START_TS=$SECONDS
set +e
wait "$K6_PID"
K6_RC=$?
K6_PID=""
set -e
K6_ELAPSED=$((SECONDS - K6_START_TS))
echo "k6 elapsed: ${K6_ELAPSED}s"

# let perf capture a tail of post-workload activity (kit cleanup, etc.)
# then stop it gracefully so it has time to flush perf.data.
sleep 2
echo "stopping perf ..."
"${USE_SUDO_PERF[@]}" kill -SIGINT "$PERF_PID" 2>/dev/null || true
wait "$PERF_PID" 2>/dev/null || true
PERF_PID=""

if ! [ -s "$OUT_DIR/perf.data" ]; then
    echo "perf.data is empty; perf.log says:" >&2
    cat "$OUT_DIR/perf.log" >&2
    exit 1
fi

if [ "$K6_RC" -ne 0 ]; then
    echo "k6 test failed (rc=$K6_RC); see $OUT_DIR/k6.log" >&2
fi

echo "rendering flamegraph ..."
"${USE_SUDO_PERF[@]}" perf script --no-inline -i "$OUT_DIR/perf.data" \
    | stackcollapse-perf.pl \
    | sed -E -s "s/^kitbgsv[^;]+/kitbgsv/" \
    | flamegraph.pl > "$OUT_DIR/flamegraph.svg"

if [ "$WITH_BROWSER_PROFILE" = "1" ]; then
    need base64 "base64 should be in any base install"
    echo "extracting browser CPU profile from k6.log ..."
    if ! grep -q '__CPUPROFILE_START__' "$OUT_DIR/k6.log"; then
        echo "no __CPUPROFILE_START__ marker in $OUT_DIR/k6.log;" >&2
        echo "did you point the test script at one that emits a profile" >&2
        echo "(e.g. dist/cool-browser-profile-test.js)?" >&2
    else
        # extract the base64-encoded chunks between START and END markers
        # and decode straight into the .cpuprofile file
        sed -n '/__CPUPROFILE_START__/,/__CPUPROFILE_END__/p' "$OUT_DIR/k6.log" \
            | grep '__CPUPROFILE_CHUNK__' \
            | sed -E 's/^.*__CPUPROFILE_CHUNK__//' \
            | tr -d '\r\n' \
            | base64 -d > "$OUT_DIR/browser.cpuprofile"
        if [ ! -s "$OUT_DIR/browser.cpuprofile" ]; then
            echo "browser.cpuprofile came out empty; check chunk extraction" >&2
        fi
    fi
fi

TOTAL_ELAPSED=$((SECONDS - START_TS))

echo
echo "done."
echo "  k6 elapsed   : ${K6_ELAPSED}s"
echo "  total elapsed: ${TOTAL_ELAPSED}s"
echo "  k6 result    : $OUT_DIR/k6.log"
echo "  perf data    : $OUT_DIR/perf.data"
echo "  flamegraph   : $OUT_DIR/flamegraph.svg"
if [ "$WITH_BROWSER_PROFILE" = "1" ] && [ -s "$OUT_DIR/browser.cpuprofile" ]; then
    echo "  browser      : $OUT_DIR/browser.cpuprofile"
    echo "                 open at https://www.speedscope.app/"
    echo "                 or in Chrome DevTools (Performance tab -> Load profile)"
fi
exit "$K6_RC"
