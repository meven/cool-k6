/node_modules/
/dist/

# perf/flamegraph run outputs (k6-flamegraph.py --out-dir defaults to profile-out)
/profile-*/

# Python bytecode cache
__pycache__/

# local run history and the dashboard built from it (the durable copy lives in
# $COOL_PERF_STORE, see CI-JENKINS.md)
/results/
/browser-dashboard.html

# cool-ci logs and reports
/ci-logs/

# marker cool-use-build writes into the online tree, not here, but a stray copy
# should never be committed
.cool-build-installed

# The ~5 MB corpus is generated by documents/gen-docs.py, ODF and the Microsoft
# formats converted from it, about 48 MB in all. The blank documents are small
# enough to commit and are tracked.
documents/*-5mb.*

# LibreOffice leaves one of these beside a document it has open, and converting
# the corpus with it can leave one behind.
documents/.~lock.*#
