#!/bin/bash
# One run: update the test bundles if this checkout moved, build origin/main,
# measure it and publish the run. cool-perf.service runs it; to run it by hand,
# start the service, so the run gets the same user and environment:
#
#   sudo systemctl start cool-perf.service
#   journalctl -u cool-perf.service -f
set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
cd "$REPO"

if [ -z "${COOLWSD_DIR:-}" ] && [ -r /etc/cool-perf.env ]; then
    set -a; . /etc/cool-perf.env; set +a
fi
: "${COOLWSD_DIR:?not set in /etc/cool-perf.env}"

step() { echo "=== $*"; }

# deploy/bootstrap writes the bootstrapped file when the first build is done,
# and holds the same lock while it builds.
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/cool-perf
if [ ! -f "$STATE/bootstrapped" ]; then
    echo "the first build is not done: run deploy/bootstrap first" >&2
    exit 1
fi
exec 9>"$STATE/lock"
flock -n 9 || { echo "a bootstrap or a nightly run is already running" >&2; exit 1; }

if [ "${COOL_PERF_SELF_UPDATE:-0}" = 1 ]; then
    step "updating perf-dashboard"
    git pull --ff-only
fi

# dist/ and node_modules/ are generated, so rebuild them whenever the checkout
# is at a commit they were not built from.
head=$(git rev-parse HEAD)
stamp=dist/.built-from
if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$head" ]; then
    step "test bundles for $head"
    npm ci --no-audit --no-fund
    npm run build
    echo "$head" > "$stamp"
fi

# cool-ci labels a run with the 12-character sha of the commit that it measured,
# and last-run.json holds the label of the last published run. When the branch
# has not moved since that run, there is nothing new to build or measure.
if [ "${COOL_PERF_SKIP_UNCHANGED:-1}" = 1 ]; then
    ref=${COOL_SRC_REF:-origin/main}
    if git -C "$COOLWSD_DIR" fetch --no-tags --quiet origin "${ref#origin/}"; then
        tip=$(git -C "$COOLWSD_DIR" rev-parse --short=12 FETCH_HEAD)
        last=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("label", ""))' \
            "${COOL_PERF_STORE:-/var/lib/cool-perf}/last-run.json" 2>/dev/null || true)
        if [ "$tip" = "$last" ]; then
            echo "$ref is still at $tip, the commit of the last published run"
            exit 0
        fi
    fi
fi

build_args=()
[ "${COOL_PERF_ENGINE:-1}" = 1 ] && build_args+=(--engine)
[ "${COOL_PERF_SAVE_BUILDS:-0}" = 1 ] || build_args+=(--no-save)
step "building ${COOL_SRC_REF:-origin/main}"
./cool-build "${build_args[@]}"

# An instance left over from an interrupted run holds a port and competes with
# the measured kit.
pkill -u "$(id -u)" -x coolwsd || true

step "measuring"
./cool-ci run
