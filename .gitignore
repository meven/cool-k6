/node_modules/
/dist/

# perf/flamegraph run outputs (k6-flamegraph.py --out-dir defaults to profile-out)
/profile-*/

# Python bytecode cache
__pycache__/

# local run history and the dashboard built from it (the durable copy lives in
# $COOL_PERF_STORE, see CI-JENKINS.md)
/results/
/browser-dashboard.html

# cool-ci logs and reports
/ci-logs/

# marker cool-use-build writes into the online tree, not here, but a stray copy
# should never be committed
.cool-build-installed

# The big corpus is generated by documents/gen-docs.py, ODF and the Microsoft
# formats converted from it, about 60 MB in all. The blank documents are small
# enough to commit and are tracked.
documents/*mb.*

# The WOPI host's TLS pair, generated per checkout (see the README). A browser
# test needs the host on https, since the host page refuses to submit to a COOL
# of another scheme, and a private key does not belong in a repository.
server/npm-server-key.pem
server/npm-server-cert.pem

# LibreOffice leaves one of these beside a document it has open, and converting
# the corpus with it can leave one behind.
documents/.~lock.*#
