#!/bin/bash
# Run cool-capacity-test.js and profile it: a perf flamegraph of coolwsd and every kit, plus a V8
# CPU profile of one real browser user that joins at the start of the last plateau.
#
# A coolwsd or WOPI host that does not answer yet is started, and stopped again at the end: coolwsd
# from COOLWSD_DIR with the command line cool-use-build derives (no make, logging at warning), the
# WOPI host with npm run server. One perf records coolwsd, the forkit and the kits already forked;
# perf record -p follows the processes these fork later, so it also records the kits the forkit
# spawns during the run and their background saves.
#
# Env (the CAP_* variables of cool-capacity-test.js are passed through to k6):
#   COOLWSD_DIR    - online checkout to start coolwsd from, when none is running
#   OUT_DIR        - output directory              (default results/capacity-<UTC time>)
#   WOPI_URL       - COOL server                   (default https://localhost:9980/)
#   WOPI_HOST      - WOPI host                     (default https://localhost:3000/)
#   PERF           - perf command, e.g. "sudo perf" (default perf)
#   PERF_FREQ      - sampling frequency in Hz      (default 49)
#   PERF_CALLGRAPH - perf --call-graph value       (default dwarf,16384)
#   MEM_FLOOR_MB   - stop the run when MemAvailable drops under this (default 1024, 0 to disable)
#   BROWSER_AT     - seconds into the run the browser user starts (default: start of the last hold)
#   TYPE_REPEATS   - sentences the browser user types (default 10)
#   EXECUTABLE     - browser for Puppeteer      (default: chromium or google-chrome on PATH)
#   NO_PERF=1, NO_BROWSER=1 - skip either profile
#   PRUNE_PERF_DATA=1 - delete perf.data once flamegraph.svg is drawn
#   SERVER_CPUS    - cores coolwsd, forkit and the kits run on              (default 0-3)
#   SERVER_MEMORY  - memory they may use together, with no swap            (default 8G)
#                    A capacity is a number of users on a server of a known size, so both are
#                    required. They need a cgroup v2 that this script may write, as under
#                    systemd-run with Delegate=yes. k6, perf, the samplers and the browser user
#                    run on the other cores, so the server has its cores to itself.
#   CAP_LOG_LEVEL  - logging.level of coolwsd and the kits (default warning). A level above
#                    warning takes cpu from what is being measured, so it suits a run that
#                    looks for a cause rather than a number, such as a heap run.
#   METRICS_INTERVAL - seconds between two samples of coolwsd's /cool/getMetrics (default 10)
#   METRICS_AUTH   - admin console user:password for /cool/getMetrics (default admin:admin)
#   SMAPS_INTERVAL - seconds between two samples of smaps.csv, 0 for none (default 30)
#   ENGINE_CONFIG  - an .xcd file of engine settings, such as deploy/engine-config/*.xcd, which
#                    the kits read: it goes into the share/registry of the engine of COOLWSD_DIR
#                    while the run lasts, and a copy into the results as engine-config.xcd.
#   HEAPTRACK      - a heaptrack with --follow-children, to record the allocations of coolwsd,
#                    forkit and the kits instead of a perf profile. The kits save in their own
#                    process, with an autosave every 60 s, because the child of a background
#                    save cannot write a trace.
#                    heap-report.py then writes heap.html, heaptrack.json, and per kind of
#                    process flamegraphs of the peak, the allocations, the temporary allocations
#                    and the leaks. heaptrack slows the server down several times, so the
#                    capacity of such a run says nothing: use a few users, and the default
#                    SERVER_MEMORY leaves room for what heaptrack adds to each process. The edit
#                    and load targets are 4 times their default (CAP_TARGET_FACTOR).
#
# Outputs in OUT_DIR: coolwsd.log and wopi.log when started here, k6.log, capacity.json, perf.data
# (coolwsd, forkit and kits), perf.log, flamegraph.svg, by-plateau/ and by-plateau.log
# (kit-profile-by-plateau.py: the kit stacks of each plateau, and a summary), and with a server
# cgroup perf-stat.csv (instructions, cycles and CPU time of the server every 5 s),
# perf-stat-total.txt and server-cgroup.txt (its limits, peak memory and OOM kills),
# browser.cpuprofile (open it in Chrome DevTools > Performance, or https://www.speedscope.app),
# browser-latency.json (keystroke latency of the browser user, its summary also on the LATENCY:
# line of browser.log), browser-memory.csv (the browser user's Chromium processes and JS heap),
# server-memory.csv (coolwsd, forkit and kits from /cool/getMetrics, plus the host's available
# memory), metrics.prom (every /cool/getMetrics sample in full), timeline.csv, kit-cpu.csv and
# events.csv (timeline-sampler.py: host memory, swap and CPU, the CPU of each COOL process, the
# background saves and the OOM kills in the server cgroup, every 0.5 s), smaps.csv (the memory of
# each server process by region: heap, anonymous mappings and each mapped file, every
# SMAPS_INTERVAL seconds), browser.log.
# latency-spikes.py OUT_DIR lines the slow edits that k6 logs on its EDIT lines up with that
# timeline.

set -euo pipefail

# coolwsd.service sets LimitNOFILE=infinity. Under the systemd default of 1024, coolwsd ran out of
# file descriptors at about 150 documents (EMFILE), and k6 users waited on sockets forever.
ulimit -n "$(ulimit -Hn)"

ROOT=$(cd "$(dirname "$0")" && pwd)
OUT_DIR=${OUT_DIR:-$ROOT/results/capacity-$(date -u +%Y%m%dT%H%M%SZ)}
WOPI_URL=${WOPI_URL:-https://localhost:9980/}
WOPI_HOST=${WOPI_HOST:-https://localhost:3000/}
read -r -a PERF_CMD <<< "${PERF:-perf}"
PERF_FREQ=${PERF_FREQ:-49}
PERF_CALLGRAPH=${PERF_CALLGRAPH:-dwarf,16384}
MEM_FLOOR_MB=${MEM_FLOOR_MB:-1024}
SERVER_CPUS=${SERVER_CPUS:-0-3}
SERVER_MEMORY=${SERVER_MEMORY:-8G}
TYPE_REPEATS=${TYPE_REPEATS:-10}
EXECUTABLE=${EXECUTABLE:-$(command -v chromium || command -v google-chrome || true)}
TEST=$ROOT/dist/cool-capacity-test.js

die() { echo "capacity-profile: $*" >&2; exit 1; }

# A k6 duration ("90s", "1m", "1.5m") in whole seconds.
seconds() {
    awk -v d="$1" 'BEGIN {
        n = d + 0; u = d; sub(/^[0-9.]+/, "", u)
        f = (u == "ms") ? 0.001 : (u == "m") ? 60 : (u == "h") ? 3600 : 1
        printf "%d", n * f }'
}

cool_up() { curl -skf -o /dev/null --max-time 3 "${WOPI_URL}hosting/discovery"; }
wopi_up() { curl -skf -o /dev/null --max-time 3 "${WOPI_HOST}wopi/files/11"; }

# Polls a check function once a second, up to $2 seconds.
wait_up() {
    local i
    for ((i = 0; i < $2; i++)); do "$1" && return 0; sleep 1; done
    return 1
}

[ -f "$TEST" ] || die "$TEST is missing, run npm run build first"
mkdir -p "$OUT_DIR"
chmod o+w "$OUT_DIR"
echo "output: $OUT_DIR"

if [ -n "${HEAPTRACK:-}" ]; then
    [ -x "$HEAPTRACK" ] || die "HEAPTRACK=$HEAPTRACK is not an executable heaptrack"
    heaptrack_help=$("$HEAPTRACK" --help 2>&1 || true)
    [[ $heaptrack_help == *--follow-children* ]] \
        || die "$HEAPTRACK has no --follow-children, which the kits that forkit forks need"
    command -v zstd >/dev/null && command -v flamegraph.pl >/dev/null \
        || die "heap-report.py needs zstd and flamegraph.pl on PATH"
    # perf and heaptrack would each slow down what the other measures.
    NO_PERF=1
    # The targets stretch with the slowdown, so that a stage fails for the server and not for
    # heaptrack.
    export CAP_TARGET_FACTOR=${CAP_TARGET_FACTOR:-4}
    echo "heaptrack: $HEAPTRACK" > "$OUT_DIR/heap-profile"
    mkdir -p "$OUT_DIR/heaptrack"
fi

# The WOPI host's certificate is signed by a local CA that coolwsd is told to trust, so coolwsd
# verifies the host as it would in production. Both are created the first time they are missing.
TLS_DIR=$ROOT/server/tls
if [ ! -s "$TLS_DIR/wopi-cert.pem" ] || [ ! -s "$TLS_DIR/ca-cert.pem" ]; then
    echo "creating the rig CA and the WOPI host certificate in $TLS_DIR"
    mkdir -p "$TLS_DIR"
    openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj "/CN=COOL perf rig CA" \
        -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -keyout "$TLS_DIR/ca-key.pem" -out "$TLS_DIR/ca-cert.pem" 2>/dev/null \
        || die "openssl could not create the CA"
    openssl req -newkey rsa:2048 -nodes -subj "/CN=localhost" \
        -keyout "$TLS_DIR/wopi-key.pem" -out "$TLS_DIR/wopi.csr" 2>/dev/null \
        || die "openssl could not create the WOPI host key"
    openssl x509 -req -in "$TLS_DIR/wopi.csr" -CA "$TLS_DIR/ca-cert.pem" -CAkey "$TLS_DIR/ca-key.pem" \
        -CAcreateserial -days 825 -out "$TLS_DIR/wopi-cert.pem" \
        -extfile <(printf '%s\n' "basicConstraints=CA:FALSE" "extendedKeyUsage=serverAuth" \
                                 "subjectAltName=DNS:localhost,IP:127.0.0.1") 2>/dev/null \
        || die "openssl could not sign the WOPI host certificate"
    rm -f "$TLS_DIR/wopi.csr"
fi

STARTED_PIDS=()
# coolwsd, forkit and the kits run in the server cgroup, on SERVER_CPUS and in SERVER_MEMORY.
# Everything else of the run stays in the runner cgroup, on the other cores.
own=/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)
# An earlier run in the same service moved this shell into the runner cgroup, whose cores are the
# client cores. The server cgroup goes beside the runner again, not inside it.
[ "${own##*/}" = runner ] && own=${own%/runner}
[ -w "$own/cgroup.subtree_control" ] \
    || die "the server limits need a delegated cgroup v2, run under systemd-run with -p Delegate=yes"
# cgroup v2 enables a controller for the children of a cgroup only when that cgroup holds no
# process itself, so the processes of this run move to a runner child first.
mkdir -p "$own/runner"
for pid in $(cat "$own/cgroup.procs"); do echo "$pid" > "$own/runner/cgroup.procs" 2>/dev/null || true; done
echo "+cpuset +memory" > "$own/cgroup.subtree_control" \
    || die "cannot enable the cpuset and memory controllers in $own"
# The cores of the list $1 that are not in the list $2, one by one: "0-3" "1" gives 0,2,3.
cpus_minus() {
    python3 - "$1" "$2" <<'EOF'
import sys
def cpus(s):
    out = set()
    for part in filter(None, s.split(",")):
        a, _, b = part.partition("-")
        out.update(range(int(a), int(b or a) + 1))
    return out
print(",".join(map(str, sorted(cpus(sys.argv[1]) - cpus(sys.argv[2])))))
EOF
}
CLIENT_CPUS=$(cpus_minus "$(cat "$own/cpuset.cpus.effective")" "$SERVER_CPUS") \
    || die "SERVER_CPUS=$SERVER_CPUS is not a list of cores"
[ -n "$CLIENT_CPUS" ] || die "no core is left for k6 and the browser user outside SERVER_CPUS=$SERVER_CPUS"
echo "$CLIENT_CPUS" > "$own/runner/cpuset.cpus" || die "cannot pin the runner to cores $CLIENT_CPUS"
SERVER_CG=$own/server
mkdir -p "$SERVER_CG"
echo "$SERVER_CPUS" > "$SERVER_CG/cpuset.cpus" || die "cannot give the server cores $SERVER_CPUS"
# The kernel gives a cgroup the cores of its parent when the cores it asks for are not among
# them, without an error.
server_effective=$(cat "$SERVER_CG/cpuset.cpus.effective")
[ "$(cpus_minus "$server_effective" "")" = "$(cpus_minus "$SERVER_CPUS" "")" ] \
    || die "the server cgroup runs on cores $server_effective, not $SERVER_CPUS"
echo "$SERVER_MEMORY" > "$SERVER_CG/memory.max" || die "cannot limit the server to $SERVER_MEMORY"
echo 0 > "$SERVER_CG/memory.swap.max"
echo "server cgroup $SERVER_CG: cores $SERVER_CPUS, memory $SERVER_MEMORY; k6 and the browser on cores $CLIENT_CPUS"
# The limits, so that a run in progress shows them; stop_started adds what the server used.
{ echo "cpuset.cpus: $(cat "$SERVER_CG/cpuset.cpus")"
  echo "cpuset.cpus.effective: $(cat "$SERVER_CG/cpuset.cpus.effective")"
  echo "memory.max: $(cat "$SERVER_CG/memory.max")"; } > "$OUT_DIR/server-cgroup.txt"
# Passed to k6, which writes them into capacity.json beside the capacity.
export CAP_SERVER_CPUS=$SERVER_CPUS CAP_SERVER_MEMORY=$SERVER_MEMORY

ENGINE_CONFIG_INSTALLED=
stop_started() {
    local pid i
    for pid in "${STARTED_PIDS[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || true; done
    STARTED_PIDS=()
    # The settings apply to this run only.
    [ -z "$ENGINE_CONFIG_INSTALLED" ] || rm -f "$ENGINE_CONFIG_INSTALLED"
    if [ -n "$SERVER_CG" ] && [ -d "$SERVER_CG" ]; then
        # How close the server came to its limit, and how often the kernel killed in it.
        { echo "cpuset.cpus: $(cat "$SERVER_CG/cpuset.cpus")"
          echo "cpuset.cpus.effective: $(cat "$SERVER_CG/cpuset.cpus.effective")"
          echo "memory.max: $(cat "$SERVER_CG/memory.max")"
          echo "memory.peak: $(cat "$SERVER_CG/memory.peak" 2>/dev/null || echo unknown)"
          cat "$SERVER_CG/memory.events"; } > "$OUT_DIR/server-cgroup.txt" 2>/dev/null || true
        for i in $(seq 30); do
            [ -s "$SERVER_CG/cgroup.procs" ] || break
            [ "$i" -lt 15 ] || kill -KILL $(cat "$SERVER_CG/cgroup.procs") 2>/dev/null || true
            sleep 1
        done
        rmdir "$SERVER_CG" 2>/dev/null || true
    fi
}
trap stop_started EXIT

if [ -n "${ENGINE_CONFIG:-}" ]; then
    [ -f "$ENGINE_CONFIG" ] || die "ENGINE_CONFIG=$ENGINE_CONFIG is not a file"
    [ -n "${COOLWSD_DIR:-}" ] || die "ENGINE_CONFIG needs the COOLWSD_DIR whose coolwsd this starts"
    registry=$COOLWSD_DIR/engine/instdir/share/registry
    [ -d "$registry" ] || die "$registry is missing, so the engine settings have nowhere to go"
    # The engine reads every .xcd file of its share/registry, after main.xcd when the file
    # depends on it.
    ENGINE_CONFIG_INSTALLED=$registry/zz-capacity-profile.xcd
    cp "$ENGINE_CONFIG" "$ENGINE_CONFIG_INSTALLED"
    cp "$ENGINE_CONFIG" "$OUT_DIR/engine-config.xcd"
    echo "engine settings: $ENGINE_CONFIG"
fi

if cool_up; then
    die "a coolwsd already answers at $WOPI_URL, outside the limits of SERVER_CPUS and SERVER_MEMORY"
fi
if ! cool_up; then
    [ -n "${COOLWSD_DIR:-}" ] || die "no coolwsd answering at $WOPI_URL; set COOLWSD_DIR to start one"
    [ -x "$COOLWSD_DIR/coolwsd" ] || die "$COOLWSD_DIR/coolwsd is missing or not built"
    cool_cmd=$(COOLWSD_DIR=$COOLWSD_DIR python3 "$ROOT/cool-use-build" run-cmd) \
        || die "cool-use-build run-cmd failed"
    # A fixed port for k6, and trace logging off: it takes cpu from what is being measured.
    # coolwsd logs to its standard error, so that its warnings, which name refused loads and
    # failed saves, land in coolwsd.log beside the output of the kits.
    log_level=${CAP_LOG_LEVEL:-warning}
    case $log_level in
        none|fatal|critical|error|warning|notice|information|debug|trace) ;;
        *) die "CAP_LOG_LEVEL=$log_level is not a level of coolwsd" ;;
    esac
    cool_cmd=$(sed -e 's/--find-free-port//' -e "s/logging\.level=[a-z]*/logging.level=$log_level/" \
                   -e 's/logging\.file\[@enable\]=true/logging.file[@enable]=false/' \
                   -e 's/logging_ui_cmd\.file\[@enable\]=true/logging_ui_cmd.file[@enable]=false/' \
                   <<< "$cool_cmd")
    # A release build verifies the WOPI host (SSL_VERIFY in configure.ac), against this CA.
    cool_cmd+=" --o:storage.ssl.ca_file_path=$TLS_DIR/ca-cert.pem"
    # Each process writes its raw trace while it runs, and heap-report.py interprets them in
    # parallel once coolwsd ends.
    # heaptrack runs a thread in every process that it traces, and unshare(CLONE_NEWUSER) fails
    # with EINVAL in a process of several threads, so coolwsd cannot build its jails in a user
    # namespace and falls back to coolforkit-caps, which holds no capabilities here. Landlock
    # isolates the kits without either.
    if [ -n "${HEAPTRACK:-}" ]; then
        cool_cmd="$HEAPTRACK --follow-children --raw -o $OUT_DIR/heaptrack/ht $cool_cmd"
        cool_cmd+=" --o:security.capabilities=false --o:mount_namespaces=false"
        # Landlock lets a kit create no file outside its jail, so the child of a background save
        # cannot open a trace. A save in the kit allocates the same, and heaptrack sees it there;
        # without background saves the 30 s idle save waits for idle users, so autosave comes
        # every 60 s instead of 300 s.
        cool_cmd+=" --o:per_document.background_autosave=false"
        cool_cmd+=" --o:per_document.autosave_duration_secs=60"
    fi
    echo "starting coolwsd: $cool_cmd"
    # shellcheck disable=SC2086 # the command line is split into its words on purpose
    (echo "$BASHPID" > "$SERVER_CG/cgroup.procs"
     cd "$COOLWSD_DIR" && exec setsid $cool_cmd) > "$OUT_DIR/coolwsd.log" 2>&1 < /dev/null &
    STARTED_PIDS+=($!)
    COOL_STARTED_PID=$!
    wait_up cool_up 90 || die "coolwsd did not come up, see $OUT_DIR/coolwsd.log"
fi

if ! wopi_up; then
    wopi_port=$(sed -E 's#^[a-z]+://[^:/]+:?([0-9]*).*#\1#' <<< "$WOPI_HOST")
    echo "starting the WOPI host on port ${wopi_port:-3000}"
    # It fetches coolwsd's discovery for the browser user, and coolwsd's certificate is self-signed.
    (cd "$ROOT" && PORT=${wopi_port:-3000} SSL_KEY_FILE=$TLS_DIR/wopi-key.pem \
        SSL_CRT_FILE=$TLS_DIR/wopi-cert.pem NODE_TLS_REJECT_UNAUTHORIZED=0 \
        exec setsid npm run server) \
        > "$OUT_DIR/wopi.log" 2>&1 < /dev/null &
    STARTED_PIDS+=($!)
    wait_up wopi_up 30 || die "the WOPI host did not come up, see $OUT_DIR/wopi.log"
fi

# A WOPI host that was already running may present another certificate, which coolwsd refuses.
wopi_hostport=$(sed -E 's#^[a-z]+://([^/]+).*#\1#' <<< "$WOPI_HOST")
openssl s_client -connect "$wopi_hostport" -servername localhost -CAfile "$TLS_DIR/ca-cert.pem" \
    -verify_return_error < /dev/null > /dev/null 2>&1 \
    || die "the WOPI host at $WOPI_HOST does not present a certificate from" \
           "$TLS_DIR/ca-cert.pem, so coolwsd would refuse every session"

COOLWSD_PID=$(pgrep -o -x coolwsd) || die "no coolwsd process"
if [ -n "${HEAPTRACK:-}" ]; then
    [ -n "${COOL_STARTED_PID:-}" ] || die "HEAPTRACK needs a coolwsd that this script starts"
    FORKIT_PID=$(pgrep -o -x forkit) || die "no forkit process"
fi
if [ -z "${NO_PERF:-}" ]; then
    command -v stackcollapse-perf.pl >/dev/null && command -v flamegraph.pl >/dev/null \
        || die "stackcollapse-perf.pl and flamegraph.pl must be on PATH (FlameGraph), or set NO_PERF=1"
    FORKIT_PID=$(pgrep -o -x forkit) || die "no forkit process"
    if [ "$(cat /proc/sys/kernel/perf_event_paranoid)" -gt 1 ] && [ "${PERF_CMD[0]}" != sudo ]; then
        echo "perf_event_paranoid is above 1: perf will likely fail, set PERF=\"sudo perf\"" \
             "or lower it with: echo 1 | sudo tee /proc/sys/kernel/perf_event_paranoid" >&2
    fi
fi

if command -v k6 >/dev/null; then
    K6=(k6 run --no-color "$TEST")
else
    # The repo's k6-run passes --vus, which replaces the test's staircase, and k6-wrap does not
    # forward CAP_*, so the container is started here.
    CAP_ENV=()
    for v in $(compgen -e | grep '^CAP_' || true); do CAP_ENV+=(-e "$v"); done
    K6=(docker run --network host --rm -i --cpuset-cpus "$CLIENT_CPUS" -v "$ROOT:/app:Z" -v "$OUT_DIR:/out:Z" -w /out
        -e WOPI_URL="$WOPI_URL" -e WOPI_HOST="$WOPI_HOST" "${CAP_ENV[@]}"
        grafana/k6:1.7.1 run --no-color /app/dist/cool-capacity-test.js)
fi

# The start of the last hold, from the same defaults as the test.
plateaus=$(tr ',' '\n' <<< "${CAP_VUS:-$(seq -s, 10 10 160)}" | grep -c .)
ramp=$(seconds "${CAP_RAMP:-20s}")
hold=$(seconds "${CAP_HOLD:-70s}")
BROWSER_AT=${BROWSER_AT:-$(( plateaus * ramp + (plateaus - 1) * hold ))}
# The stages, the 30 s ramp down and the 30 s graceful stop of the test, and 2 minutes more.
K6_DEADLINE=$(( plateaus * (ramp + hold) + 60 + 120 ))

# perf copies every binary it samples into a build-id cache, ~/.debug by default, which nothing
# empties: about 1.2 GB of engine library per build. The run keeps its own, deleted at the end.
BUILDID_DIR=$OUT_DIR/buildid
# The perf stat of the server, by its command line, which stop_perf ends.
PERF_STAT_PATTERN="perf stat .* -o $OUT_DIR/perf-stat.csv"

# Delete files that perf wrote, which belong to root under PERF="sudo perf".
rm_perf_files() {
    if [ "${PERF_CMD[0]}" = sudo ]; then sudo rm -rf "$@"; else rm -rf "$@"; fi
}

perf_record() {
    "${PERF_CMD[@]}" --buildid-dir "$BUILDID_DIR" record -F "$PERF_FREQ" --call-graph "$PERF_CALLGRAPH" -p "$1" -o "$2" \
        >> "$OUT_DIR/perf.log" 2>&1
}

PERF_PID=
if [ -z "${NO_PERF:-}" ]; then
    # The spare kits were forked before this perf starts, so they are named here.
    KIT_PIDS=$(pgrep -d, '^(kit_spare|kitbroker)_' || true)
    echo "perf: recording coolwsd $COOLWSD_PID, forkit $FORKIT_PID, kits ${KIT_PIDS:-none}" \
         "and what they fork at $PERF_FREQ Hz"
    perf_record "$COOLWSD_PID,$FORKIT_PID${KIT_PIDS:+,$KIT_PIDS}" "$OUT_DIR/perf.data" &
    PERF_PID=$!
    sleep 2
    kill -0 "$PERF_PID" 2>/dev/null || die "perf did not start, see $OUT_DIR/perf.log"
fi

# The instructions, cycles and CPU time of the whole server, every 5 s, so that each step of the
# staircase can be read off. Counting by cgroup takes in every kit, whenever it was forked, and
# needs the server cgroup of SERVER_CPUS or SERVER_MEMORY.
if [ -z "${NO_PERF:-}" ] && [ -n "$SERVER_CG" ]; then
    echo "perf stat: counting the server cgroup every 5 s into perf-stat.csv"
    LC_ALL=C "${PERF_CMD[@]}" stat -e instructions,cycles,task-clock -a \
        -G "${SERVER_CG#/sys/fs/cgroup/}" -I 5000 -x , -o "$OUT_DIR/perf-stat.csv" \
        >> "$OUT_DIR/perf.log" 2>&1 &
fi

BROWSER_PID=
if [ -z "${NO_BROWSER:-}" ]; then
    echo "browser user: starts ${BROWSER_AT}s into the run"
    # Its own document, so the profile is of one user rather than of a shared document.
    ( sleep "$BROWSER_AT"
      touch "$OUT_DIR/.browser-started"
      WOPI_URL=$WOPI_URL WOPI_HOST=$WOPI_HOST FILE_ID=${CAP_FILE_ID:-11}~browser TYPE_REPEATS=$TYPE_REPEATS EXECUTABLE=$EXECUTABLE \
          OUT_PATH=$OUT_DIR/browser.cpuprofile NODE_TLS_REJECT_UNAUTHORIZED=0 \
          node "$ROOT/cool-puppeteer-profile.js" ) > "$OUT_DIR/browser.log" 2>&1 &
    BROWSER_PID=$!
fi

# perf record finishes its file on SIGTERM. The perf of this run writes under OUT_DIR, which
# finds it under sudo too, where a signal to sudo from its own process group is not relayed.
stop_perf() {
    local stat_signal=(pkill -INT -f)
    if [ "${PERF_CMD[0]}" = sudo ]; then stat_signal=(sudo "${stat_signal[@]}"); fi
    "${stat_signal[@]}" "$PERF_STAT_PATTERN" 2>/dev/null || true
    [ -n "$PERF_PID" ] || return 0
    local pattern="perf .*record .* -o $OUT_DIR/perf.data" signal=(pkill -TERM -f) i
    if [ "${PERF_CMD[0]}" = sudo ]; then signal=(sudo "${signal[@]}"); fi
    "${signal[@]}" "$pattern" || true
    # dwarf captures take a while to flush.
    for ((i = 0; i < 120; i++)); do pgrep -f "$pattern" >/dev/null || break; sleep 1; done
    PERF_PID=
}

stop_browser() {
    [ -n "$BROWSER_PID" ] || return 0
    pkill -P "$BROWSER_PID" 2>/dev/null || true
    kill "$BROWSER_PID" 2>/dev/null || true
    wait "$BROWSER_PID" 2>/dev/null || true
    BROWSER_PID=
}
K6_PID=
stop_k6() {
    [ -n "$K6_PID" ] || return 0
    kill -TERM "$K6_PID" 2>/dev/null || true
    wait "$K6_PID" 2>/dev/null || true
    K6_PID=
}

# Sends k6 a SIGTERM when MemAvailable drops under MEM_FLOOR_MB. k6 then stops its users, so the
# kits close their documents, and the perf captures so far are still written out.
mem_watch() {
    local avail
    while sleep 2; do
        avail=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)
        [ "$avail" -lt "$MEM_FLOOR_MB" ] || continue
        echo "capacity-profile: MemAvailable is ${avail} MB, under MEM_FLOOR_MB=$MEM_FLOOR_MB," \
             "stopping k6" >&2
        touch "$OUT_DIR/.memory-floor"
        kill -TERM "$1" 2>/dev/null || true
        return
    done
}
# Sends k6 a SIGTERM when coolwsd exits, for example when the kernel OOM killer picks it. Without
# coolwsd every user only fails, so the rest of the ramp measures nothing.
server_watch() {
    while sleep 1; do
        kill -0 "$COOLWSD_PID" 2>/dev/null && continue
        echo "capacity-profile: coolwsd (pid $COOLWSD_PID) exited, stopping k6" >&2
        echo "$(( $(date +%s) - $2 ))" > "$OUT_DIR/.server-exited"
        kill -TERM "$1" 2>/dev/null || true
        return
    done
}
# Server memory as coolwsd reports it: coolwsd (PSS), the forkit (RSS) and the document kits. Each
# /cool/getMetrics answer is kept whole in metrics.prom, and server-memory.csv has one row of
# memory columns per sample, with the host's available memory for comparison.
metrics_sample() {
    local start=$1 body t avail
    echo "elapsed_s,coolwsd_mb,forkit_mb,kits_mb,kit_max_mb,kit_count,kit_assigned,kit_killed_oom,host_available_mb" \
        > "$OUT_DIR/server-memory.csv"
    while :; do
        t=$(( $(date +%s) - start ))
        avail=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)
        if body=$(curl -skf --max-time 5 -u "$METRICS_AUTH" "${WOPI_URL}cool/getMetrics"); then
            printf '# sample elapsed_s=%s\n%s\n' "$t" "$body" >> "$OUT_DIR/metrics.prom"
            awk -v t="$t" -v avail="$avail" '
                NF == 2 { v[$1] = $2 }
                END {
                    mb = 1048576
                    printf "%d,%.0f,%.0f,%.0f,%.0f,%d,%d,%d,%d\n", t,
                        v["coolwsd_memory_used_bytes"] / mb, v["forkit_memory_used_bytes"] / mb,
                        v["kit_memory_used_total_bytes"] / mb, v["kit_memory_used_max_bytes"] / mb,
                        v["kit_count"], v["kit_assigned_count"], v["kit_killed_oom_count"], avail
                }' <<< "$body" >> "$OUT_DIR/server-memory.csv"
        else
            # coolwsd did not answer in time: the row keeps the gap visible.
            echo "$t,,,,,,,,$avail" >> "$OUT_DIR/server-memory.csv"
        fi
        sleep "${METRICS_INTERVAL:-10}"
    done
}
METRICS_AUTH=${METRICS_AUTH:-admin:admin}

MEM_WATCH_PID=
SERVER_WATCH_PID=
METRICS_PID=
TIMELINE_PID=
trap '[ -z "$MEM_WATCH_PID" ] || kill "$MEM_WATCH_PID" 2>/dev/null || true; [ -z "$SERVER_WATCH_PID" ] || kill "$SERVER_WATCH_PID" 2>/dev/null || true; [ -z "$METRICS_PID" ] || kill "$METRICS_PID" 2>/dev/null || true; [ -z "$TIMELINE_PID" ] || kill "$TIMELINE_PID" 2>/dev/null || true; stop_k6; stop_perf; stop_browser; stop_started; exit 130' INT TERM

echo "k6: ${K6[*]}"
k6_status=0
# k6 runs in the background so that mem_watch has its pid to signal.
( cd "$OUT_DIR" && exec env WOPI_URL="$WOPI_URL" WOPI_HOST="$WOPI_HOST" "${K6[@]}" ) \
    > >(tee "$OUT_DIR/k6.log") 2>&1 &
K6_PID=$!
# k6 does not interrupt a user that waits on a socket the server keeps open, so a run where the
# server stopped answering would never end. Past the deadline k6 is stopped, and still writes
# its summary.
# A SIGTERM only starts a graceful stop, which waits for those same users, so a k6 that is
# still there a minute later gets a SIGKILL.
( sleep "$K6_DEADLINE"
  echo "capacity-profile: k6 still runs ${K6_DEADLINE}s after its start, stopping it" >&2
  kill -TERM "$K6_PID" 2>/dev/null || exit 0
  sleep 60
  kill -0 "$K6_PID" 2>/dev/null || exit 0
  echo "capacity-profile: k6 ignored SIGTERM, killing it" >&2
  kill -KILL "$K6_PID" 2>/dev/null || true ) &
K6_WATCHDOG_PID=$!
if [ "$MEM_FLOOR_MB" -gt 0 ]; then
    mem_watch "$K6_PID" &
    MEM_WATCH_PID=$!
fi
server_watch "$K6_PID" "$(date +%s)" &
SERVER_WATCH_PID=$!
metrics_sample "$(date +%s)" &
METRICS_PID=$!
python3 "$ROOT/timeline-sampler.py" "$OUT_DIR" --cgroup "$SERVER_CG" \
    --smaps-interval "${SMAPS_INTERVAL:-30}" &
TIMELINE_PID=$!
wait "$K6_PID" || k6_status=$?
K6_PID=
kill "$K6_WATCHDOG_PID" 2>/dev/null || true
[ -z "$MEM_WATCH_PID" ] || kill "$MEM_WATCH_PID" 2>/dev/null || true
kill "$SERVER_WATCH_PID" 2>/dev/null || true
SERVER_WATCH_PID=
kill "$METRICS_PID" 2>/dev/null || true
METRICS_PID=
kill "$TIMELINE_PID" 2>/dev/null || true
wait "$TIMELINE_PID" 2>/dev/null || true
TIMELINE_PID=
stop_perf

if [ -n "${HEAPTRACK:-}" ]; then
    # The kits write the end of their traces as they exit, and heaptrack compresses every trace
    # once coolwsd ends.
    kill -TERM "$COOLWSD_PID" 2>/dev/null || true
    for i in $(seq 600); do
        kill -0 "$COOL_STARTED_PID" 2>/dev/null || break
        sleep 1
    done
    kill -0 "$COOL_STARTED_PID" 2>/dev/null \
        && echo "heaptrack still runs 600 s after coolwsd was asked to stop" >&2
    python3 "$ROOT/heap-report.py" "$OUT_DIR" --heaptrack "$HEAPTRACK" \
        --coolwsd-pid "$COOLWSD_PID" --forkit-pid "$FORKIT_PID" --jobs "$(nproc)" \
        || echo "heap-report.py failed" >&2
fi

memory_floor=
if [ -e "$OUT_DIR/.memory-floor" ]; then
    memory_floor=1
    rm -f "$OUT_DIR/.memory-floor"
    [ "$k6_status" -ne 0 ] || k6_status=1
fi

server_exited=
if [ -e "$OUT_DIR/.server-exited" ]; then
    server_exited=$(cat "$OUT_DIR/.server-exited")
    rm -f "$OUT_DIR/.server-exited"
    [ "$k6_status" -ne 0 ] || k6_status=1
fi

if [ -n "$BROWSER_PID" ]; then
    if [ -n "$memory_floor" ] || [ -n "$server_exited" ]; then
        stop_browser
    elif [ ! -e "$OUT_DIR/.browser-started" ]; then
        echo "the run ended before the browser user's start, no browser profile" >&2
        stop_browser
    elif ! wait "$BROWSER_PID"; then
        echo "browser profile failed, see $OUT_DIR/browser.log" >&2
    fi
    rm -f "$OUT_DIR/.browser-started"
fi

if [ -z "${NO_PERF:-}" ] && [ -s "$OUT_DIR/perf.data" ]; then
    # Drawn as the suite draws its captures: the stacks of coolwsd and forkit under one frame,
    # each in colours of its own, and those of the kits under another.
    python3 -c 'import json, sys; print(json.dumps({"perf_cmd": sys.argv[3:], "wsd_pids": [sys.argv[1]], "forkit_pids": [sys.argv[2]]}))' \
        "$COOLWSD_PID" "$FORKIT_PID" "${PERF_CMD[@]}" --buildid-dir "$BUILDID_DIR" \
        > "$OUT_DIR/render-job.json"
    python3 "$ROOT/k6-flamegraph.py" --render-only --out-dir "$OUT_DIR" \
        || echo "the flamegraph could not be drawn" >&2
    # Now, while the binaries that perf unwinds from are those of the run.
    if [ -s "$OUT_DIR/capacity.json" ]; then
        python3 "$ROOT/kit-profile-by-plateau.py" "$OUT_DIR" --freq "$PERF_FREQ" \
            -- "${PERF_CMD[@]}" --buildid-dir "$BUILDID_DIR" > "$OUT_DIR/by-plateau.log" 2>&1 \
            || echo "the kit profile could not be split by plateau, see by-plateau.log" >&2
    fi
    [ -z "${PRUNE_PERF_DATA:-}" ] || rm_perf_files "$OUT_DIR/perf.data" "$OUT_DIR/perf.data.old"
fi
rm_perf_files "$BUILDID_DIR"

if [ -s "$OUT_DIR/perf-stat.csv" ]; then
    awk -F, '$4 ~ /instructions/ { i += $2 } $4 ~ /cycles/ { c += $2 }
             END { if (c) printf "server: %.1f G instructions, %.1f G cycles, IPC %.2f\n",
                                 i / 1e9, c / 1e9, i / c }' "$OUT_DIR/perf-stat.csv" \
        | tee "$OUT_DIR/perf-stat-total.txt"
fi

# A capacity run is meant to reach a limit of the server, so a run that measured at least one
# plateau and then hit one exits with 0: k6 exits with 99 when a plateau misses its response time
# or failed sessions targets, and the kernel kills coolwsd when the cgroup runs out of memory.
# coolwsd exiting without an OOM kill, the host floor and every other k6 error stay failures.
oom_kills=0
[ -z "$SERVER_CG" ] || [ ! -r "$SERVER_CG/memory.events" ] \
    || oom_kills=$(awk '$1 == "oom_kill" { print $2 }' "$SERVER_CG/memory.events")
measured=
python3 -c 'import json, sys
plateaus = json.load(open(sys.argv[1]))["plateaus"]
sys.exit(0 if any(p["reached"] and p["measured"] for p in plateaus) else 1)' \
    "$OUT_DIR/capacity.json" 2>/dev/null && measured=1
limit=
if [ -n "$measured" ] && [ -z "$memory_floor" ]; then
    if [ -n "$server_exited" ] && [ "${oom_kills:-0}" -gt 0 ]; then
        limit="memory, $oom_kills OOM kills in the server cgroup"
    elif [ -z "$server_exited" ] && [ "$k6_status" -eq 99 ]; then
        limit="response time or failed sessions"
    fi
fi

echo
ls -la "$OUT_DIR"
if [ -n "$limit" ]; then
    echo "the run reached a limit of the server: $limit"
    [ -z "$server_exited" ] || echo "coolwsd was killed ${server_exited}s after the start of k6"
    exit 0
fi
[ -z "$server_exited" ] \
    || echo "the run was stopped early: coolwsd exited ${server_exited}s after the start of k6" >&2
[ -z "$memory_floor" ] || echo "the run was stopped early: MemAvailable dropped under ${MEM_FLOOR_MB} MB" >&2
exit "$k6_status"
